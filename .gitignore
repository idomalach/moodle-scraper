# Personal config (contains your course IDs and local paths)
moodle_sync_config.json

# Sync state (generated at runtime)
.moodle_manifest.json

# macOS
.DS_Store

# Excel temp files
~$*.xlsx

# Downloaded course folders (this repo is just the engine, not the content)
שנה*/

# Distributable build artifact (regenerated from the extension folder)
moodle-scraper*.zip

# Landing-page build artifact (copied from the extension zip by build.sh)
landing/assets/*.zip

# Local tooling / preview config
.claude/
